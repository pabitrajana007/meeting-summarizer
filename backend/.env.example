# ---------- Transcription ----------
# local  -> faster-whisper on your machine (free, private)
# openai -> any OpenAI-compatible Whisper API (OpenAI, Groq, ...)
# mock   -> fake transcript, for testing the app without models/keys
TRANSCRIBER=local
WHISPER_MODEL=small            # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu             # cpu | cuda
WHISPER_COMPUTE_TYPE=int8      # int8 on CPU, float16 on GPU

# Used when TRANSCRIBER=openai
STT_API_KEY=
STT_BASE_URL=                  # e.g. https://api.groq.com/openai/v1 (blank = OpenAI)
STT_MODEL=whisper-1            # Groq: whisper-large-v3-turbo

# ---------- Summarization ----------
# anthropic -> Claude
# openai    -> any OpenAI-compatible chat API (OpenAI, Groq, Ollama, Gemini-compat...)
# mock      -> fake summary, for testing
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=
LLM_BASE_URL=                  # e.g. http://localhost:11434/v1 for Ollama

# ---------- App ----------
CHUNK_WORDS=1500               # transcript words per map step
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=sqlite:///./data/meetings.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=500
